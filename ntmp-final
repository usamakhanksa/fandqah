/* hero visual: planes */
.hv{position:relative;height:min(560px,70vw);perspective:1200px}
.hv .plane{position:absolute;inset:0;transform:translate(calc(var(--mx,0)*var(--k)*1px),calc(var(--my,0)*var(--k)*1px + var(--sy,0)*var(--ks)*1px));transition:transform .08s linear}
.hv .p-back{--k:-6;--ks:.05} .hv .p-mid{--k:4;--ks:-.02} .hv .p-front{--k:14;--ks:-.06}
.hv svg.flow{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
.hv .wire{fill:none;stroke:var(--beige-18);stroke-width:1.5}
.hv .wire-on{fill:none;stroke:var(--coral);stroke-width:2;stroke-dasharray:1000;stroke-dashoffset:1000;animation:draw 2.2s var(--ease) .4s forwards}
.hv .dot{fill:var(--coral);offset-path:path("M 150 150 C 260 150 240 420 390 420");animation:travel 3.2s linear 1.2s infinite}
