.dash .side a{padding:.55rem .7rem;border-radius:var(--r-s);text-decoration:none;display:flex;align-items:center;gap:.6rem;opacity:.75;position:relative;transition:all .4s}
.dash .side a svg{width:1rem;height:1rem;flex:0 0 auto}
.dash .side a.active{background:var(--coral);color:var(--navy);opacity:1;font-weight:600}
.dash .side a.active::after{content:"";position:absolute;inset:-4px;border:2px solid var(--coral);border-radius:9px;opacity:0;animation:focusring 1.6s ease-out .9s 2}
@keyframes focusring{0%{opacity:0;transform:scale(1)}30%{opacity:1}100%{opacity:0;transform:scale(1.06)}}
.dash .main{padding:1.1rem}
.dash .main .bar{display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap}
.dash .main .bar h4{font-size:1rem}
.dash .mini-btns{display:flex;gap:.5rem}
.dash .mini-btns span{padding:.45rem .8rem;border-radius:var(--r-s);font-size:.8rem;font-weight:600;border:1.5px solid var(--navy-18)}
.dash .mini-btns span.hot{background:var(--coral);color:var(--navy);border-color:var(--coral);animation:hotpulse 2s ease-in-out 1.2s 3}
@keyframes hotpulse{50%{transform:translateY(-2px);box-shadow:0 8px 16px -8px rgba(233,90,84,.8)}}
.dash table{width:100%;border-collapse:collapse;margin-top:1rem;font-size:.82rem}
.dash th,.dash td{text-align:start;padding:.55rem .5rem;border-bottom:1px solid var(--navy-08)}
.dash th{color:var(--navy-70);font-weight:600}
@media (max-width:560px){.dash{grid-template-columns:1fr}.dash .side{display:flex;flex-wrap:wrap}}

/* ============ SPREADSHEET (step 03, 08) ============ */
.sheet{font-size:.85rem}
.sheet table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}
.sheet th,.sheet td{padding:.6rem .8rem;text-align:start;border:1px solid var(--navy-08)}
