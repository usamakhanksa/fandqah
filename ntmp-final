.upload .track{height:10px;border-radius:999px;background:var(--beige-08);overflow:hidden}
.upload .track i{display:block;height:100%;width:0;background:var(--coral);border-radius:999px;transition:width 2.4s cubic-bezier(.3,.9,.4,1)}
.in .upload .track i{width:100%}
.upload ul{list-style:none;padding:0;margin:1.2rem 0 0;display:grid;gap:.5rem}
.upload li{display:flex;align-items:center;gap:.6rem;opacity:0;transform:translateY(8px);transition:all .4s var(--ease)}
.in .upload li{opacity:1;transform:none}
.in .upload li:nth-child(1){transition-delay:1.9s}.in .upload li:nth-child(2){transition-delay:2.3s}.in .upload li:nth-child(3){transition-delay:2.7s}
