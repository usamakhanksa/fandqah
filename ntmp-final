.chart h4 small{font-weight:400;font-size:.75rem}
.chart svg{width:100%;height:auto;overflow:visible}
.chart .ln{fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round;pathLength:1;stroke-dasharray:1;stroke-dashoffset:1;transition:stroke-dashoffset 1.8s var(--ease)}
.in .chart .ln{stroke-dashoffset:0}
.chart .ln.rev{stroke:var(--coral)} .chart .ln.exp{stroke:var(--green)}
.chart .area{fill:var(--coral);opacity:0;transition:opacity 1.2s .6s}
.in .chart .area{opacity:.12}
.chart .bar{fill:var(--peach);transform:scaleY(0);transform-origin:bottom;transition:transform .9s var(--ease)}
.in .chart .bar{transform:scaleY(1)}
.in .chart .bar:nth-child(2){transition-delay:.1s}.in .chart .bar:nth-child(3){transition-delay:.2s}.in .chart .bar:nth-child(4){transition-delay:.3s}.in .chart .bar:nth-child(5){transition-delay:.4s}.in .chart .bar:nth-child(6){transition-delay:.5s}.in .chart .bar:nth-child(7){transition-delay:.6s}
