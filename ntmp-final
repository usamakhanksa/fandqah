.map .col{display:grid;gap:.75rem;align-content:center}
.map .col h4{font-size:.8rem;letter-spacing:.06em;color:var(--beige-70);margin-bottom:.3rem;font-weight:600}
.mrow{display:flex;align-items:center;justify-content:space-between;gap:.8rem;padding:.9rem 1.1rem;border-radius:var(--r-s);border:1.5px solid var(--beige-18);background:var(--beige-04);font-weight:500;transition:all .5s var(--ease);min-height:3.6rem}
.mrow code{font-family:inherit;font-weight:600;color:var(--coral);font-variant-numeric:tabular-nums}
.mrow .mb{opacity:0;transform:scale(.7);transition:all .4s var(--ease)}
.mrow.on{border-color:var(--green);background:var(--green-25)}
