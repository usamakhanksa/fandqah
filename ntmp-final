.sync-ring.done .arc,.sync-ring.done .arc2{animation:none;stroke-dasharray:none;stroke:var(--green)}
.stack{display:grid;gap:.7rem}
.stack .node{padding:1rem 1.2rem;border-radius:var(--r-s);border:1.5px solid var(--beige-18);background:var(--beige-04);font-weight:600;display:flex;justify-content:space-between;align-items:center;gap:1rem;transition:all .5s}
.stack .node small{font-weight:400;color:var(--beige-70);display:block;font-size:.8rem}
.stack .node.ok{border-color:var(--green)}
.stack .updown{text-align:center;color:var(--coral);height:1rem;line-height:1;position:relative}
.stack .updown::before,.stack .updown::after{content:"";position:absolute;left:50%;width:2px;height:100%;background:var(--beige-18)}
.stack .updown i{position:absolute;left:50%;top:0;width:6px;height:6px;margin-left:-2px;border-radius:50%;background:var(--coral);animation:updown 1.4s ease-in-out infinite}
@keyframes updown{0%{transform:translateY(-2px)}50%{transform:translateY(12px)}100%{transform:translateY(-2px)}}
