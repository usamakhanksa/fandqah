.light .pipe .arr::after,.peachy .pipe .arr::after{border-inline-start-color:var(--navy-18)}
.pipe .arr.on{background:var(--coral)} .pipe .arr.on::after{border-inline-start-color:var(--coral)}
.pipe.vert{flex-direction:column}
.pipe.vert .arr{width:2px;height:1.8rem}
.pipe.vert .arr::after{inset-inline-end:auto;left:-4px;top:auto;bottom:-1px;border:5px solid transparent;border-top:6px solid var(--beige-18);border-inline-start-color:transparent}
.light .pipe.vert .arr::after{border-top-color:var(--navy-18)} .pipe.vert .arr.on::after{border-top-color:var(--coral)}
@media (max-width:640px){.pipe:not(.keep){flex-direction:column}.pipe:not(.keep) .arr{width:2px;height:1.6rem}.pipe:not(.keep) .arr::after{inset-inline-end:auto;left:-4px;top:auto;bottom:-1px;border:5px solid transparent;border-top:6px solid var(--beige-18);border-inline-start-color:transparent}.light .pipe:not(.keep) .arr::after{border-top-color:var(--navy-18)}.pipe:not(.keep) .arr.on::after{border-top-color:var(--coral)}}
.chk{width:1.1em;height:1.1em;border-radius:50%;background:var(--green);color:var(--navy);display:inline-grid;place-items:center;font-size:.7em;font-weight:700;flex:0 0 auto}

/* ============ SYSTEM MODAL (step 01) ============ */
.modal-ui{background:#fff;color:var(--navy);border-radius:var(--r-m);box-shadow:0 40px 80px -40px rgba(42,39,60,.5),0 0 0 1px var(--navy-08);max-width:560px;margin-inline:auto;font-size:.9rem;overflow:hidden}
