@keyframes pfly{0%{transform:translate(0,0);opacity:0}10%{opacity:.9}90%{opacity:.6}100%{transform:translate(var(--dx),var(--dy));opacity:0}}
@media (max-width:900px){.sync-wrap{grid-template-columns:1fr}}

/* ============ BALANCE (step 10) ============ */
