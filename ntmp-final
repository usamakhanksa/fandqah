.in .sheet tbody tr{opacity:1;transform:none}
.in .sheet tbody tr:nth-child(1){transition-delay:.3s}.in .sheet tbody tr:nth-child(2){transition-delay:.55s}.in .sheet tbody tr:nth-child(3){transition-delay:.8s}.in .sheet tbody tr:nth-child(4){transition-delay:1.05s}
.sheet td.hl{position:relative}
.sheet td.hl::after{content:"";position:absolute;inset:0;background:var(--peach-45);opacity:0;animation:cellhl 1.6s ease-out forwards;animation-delay:inherit}
.in .sheet tbody tr:nth-child(1) td.hl::after{animation-delay:.9s}.in .sheet tbody tr:nth-child(2) td.hl::after{animation-delay:1.15s}.in .sheet tbody tr:nth-child(3) td.hl::after{animation-delay:1.4s}.in .sheet tbody tr:nth-child(4) td.hl::after{animation-delay:1.65s}
@keyframes cellhl{0%{opacity:0}30%{opacity:1}100%{opacity:0}}
.sheet .code{color:var(--coral);font-weight:600}
.dl-row{display:flex;align-items:center;gap:1rem;padding:.9rem 1.1rem;background:var(--navy);color:var(--beige);border-radius:var(--r-m);margin-top:1rem;font-size:.9rem}
.dl-row .fileic{width:2.4rem;height:2.4rem;border-radius:var(--r-s);background:var(--green-25);display:grid;place-items:center;color:var(--beige)}
.dl-row .fileic svg{width:1.2rem;height:1.2rem}
.dl-row .meta{flex:1} .dl-row .meta small{display:block;color:var(--beige-70);font-size:.78rem}
.dl-row .dbtn{padding:.5rem .9rem;background:var(--coral);color:var(--navy);border-radius:var(--r-s);font-weight:600;font-size:.82rem}

/* ============ PEAK: MAPPING ============ */
.peak{position:relative;height:380vh;--p:0}
.peak .stage{position:sticky;top:0;height:100svh;display:flex;align-items:center;overflow:hidden}
