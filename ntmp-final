@keyframes blink{50%{opacity:0}}
.form-ui .inp .chev{width:.9rem;height:.9rem;opacity:.5}
.form-ui .fbtn{margin-top:1.2rem;height:2.8rem;border-radius:var(--r-s);background:var(--coral);color:var(--navy);font-weight:600;display:grid;place-items:center;transition:background .3s,transform .2s;width:100%}
.form-ui .fbtn:hover{transform:translateY(-1px)}
.form-ui .fbtn.saving{background:var(--peach)}
.form-ui .fbtn.done{background:var(--green)}
