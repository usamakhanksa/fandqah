if(!reduced){ const P=$("#particles"); for(let i=0;i<22;i++){ const s=document.createElement("i"); s.style.left=Math.random()*100+"%"; s.style.top=Math.random()*100+"%"; s.style.setProperty("--dx",(Math.random()*240-120)+"px"); s.style.setProperty("--dy",(Math.random()*240-120)+"px"); s.style.animationDelay=(Math.random()*4)+"s"; s.style.animationDuration=(3+Math.random()*3)+"s"; P.appendChild(s);} }

/* ============ SEND PIPELINE (step 11) ============ */
$("#sendPipe").addEventListener("reveal",()=>{
  const nodes=$$("#sendPipe .node"), arrs=$$("#sendPipe .arr");
  nodes.forEach((n,i)=>setTimeout(()=>{ n.classList.add(i>=nodes.length-1||i===1||i===2?"ok":"on"); if(arrs[i]) arrs[i].classList.add("on"); }, reduced?0:300+i*450));
  setTimeout(()=>{ $("#sendBtn").textContent=T[lang]["sp.sent"]; $("#sendBtn").style.background="var(--green)"; }, reduced?0:300+nodes.length*450+400);
