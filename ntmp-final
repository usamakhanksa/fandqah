.form-ui label{display:block;font-size:.8rem;font-weight:500;color:var(--navy-70);margin-bottom:.35rem}
.form-ui .inp{height:2.6rem;border:1px solid var(--navy-18);border-radius:var(--r-s);background:var(--beige);display:flex;align-items:center;justify-content:space-between;padding-inline:.8rem;font-variant-numeric:tabular-nums;position:relative;overflow:hidden}
.form-ui .inp .val{opacity:0;transform:translateY(6px);transition:all .4s var(--ease)}
