.modal-ui .mh button{width:2rem;height:2rem;display:grid;place-items:center;border-radius:var(--r-s);opacity:.7}
.modal-ui .mb{padding:1.2rem}
.modal-ui .status{text-align:center;margin-bottom:1rem}
.modal-ui .note{background:var(--peach-45);border-inline-start:3px solid var(--coral);padding:.9rem 1rem;border-radius:var(--r-s);font-size:.88rem;margin-bottom:1.2rem}
.modal-ui label{display:block;font-weight:500;margin:.9rem 0 .4rem}
.modal-ui .inp{height:2.7rem;border:1px solid var(--navy-18);border-radius:var(--r-s);background:var(--beige);display:flex;align-items:center;padding-inline:.9rem;color:var(--navy-70);position:relative;overflow:hidden}
.modal-ui .inp .typed{font-variant-numeric:tabular-nums;letter-spacing:.04em}
.modal-ui .inp.pw .typed{letter-spacing:.2em}
.modal-ui .mbtn{margin-top:1.4rem;width:100%;height:2.9rem;border-radius:var(--r-s);background:var(--coral);color:var(--navy);font-weight:600;display:grid;place-items:center;transition:background .3s}
.modal-ui .mbtn.ok{background:var(--green)}
.conn-diagram{margin-top:2.5rem}
