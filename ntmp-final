const $=(s,r=document)=>r.querySelector(s), $$=(s,r=document)=>[...r.querySelectorAll(s)];
const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
let lang="ar";

/* ============ FAQ RENDER ============ */
function renderFaq(){
  const list=$("#faqList"); list.innerHTML="";
  T[lang].faq.forEach((q,i)=>{
    const item=document.createElement("div"); item.className="faq-item";
    item.innerHTML=`<h3 style="font-size:inherit;font-weight:inherit;margin:0"><button type="button" aria-expanded="false" aria-controls="faq-a${i}" id="faq-q${i}"><span>${q[0]}</span><span class="pm" aria-hidden="true"></span></button></h3><div class="ans" id="faq-a${i}" role="region" aria-labelledby="faq-q${i}"><div><p>${q[1]}</p></div></div>`;
    const b=$("button",item);
    b.addEventListener("click",()=>{const open=item.classList.toggle("open");b.setAttribute("aria-expanded",open);});
    list.appendChild(item);
  });
  $("#ldFaq").textContent=JSON.stringify({"@context":"https://schema.org","@type":"FAQPage","mainEntity":T[lang].faq.map(q=>({"@type":"Question","name":q[0],"acceptedAnswer":{"@type":"Answer","text":q[1]}}))});
}

/* ============ I18N APPLY ============ */
function applyLang(l){
  lang=l; const d=T[l];
  document.documentElement.lang=l; document.documentElement.dir=l==="ar"?"rtl":"ltr";
  document.documentElement.style.setProperty("--tx", l==="ar"?"right":"left");
  $$("[data-i18n]").forEach(el=>{const k=el.dataset.i18n; if(d[k]!=null) el.textContent=d[k];});
  document.title=d["meta.title"];
  ["metaDesc","ogDesc","twDesc"].forEach(id=>$("#"+id).setAttribute("content",d["meta.desc"]));
  ["ogTitle","twTitle"].forEach(id=>$("#"+id).setAttribute("content",d["meta.title"]));
  $("#ogLocale").setAttribute("content", l==="ar"?"ar_SA":"en_US");
  $("link[rel=canonical]").href=`https://fandaqah.com/${l}/financial-integration`;
  $$("[data-lang]").forEach(b=>b.setAttribute("aria-pressed", b.dataset.lang===l));
  if($("#mBtn").classList.contains("ok")) $("#mBtn").textContent=d["m.saved"];
  $("#lblDebit").textContent=d["bal.debit"]; $("#lblCredit").textContent=d["bal.credit"];
  $$(".fbtn").forEach(b=>{ if(!b.classList.contains("done")&&!b.classList.contains("saving")) b.textContent=d[b.dataset.label]; });
  renderFaq();
  try{ history.replaceState(null,"",location.pathname+location.search+(location.hash||"")); }catch(e){}
  try{ localStorage.setItem("fq-lang",l); }catch(e){}
}
$$("[data-lang]").forEach(b=>b.addEventListener("click",()=>{ if(b.dataset.lang!==lang){ const y=scrollY; applyLang(b.dataset.lang); requestAnimationFrame(()=>scrollTo(0,y)); }}));
let saved=null; try{ saved=localStorage.getItem("fq-lang"); }catch(e){}
if(/[?&]lang=en/.test(location.search)) saved="en"; else if(/[?&]lang=ar/.test(location.search)) saved="ar";
applyLang(saved==="en"?"en":"ar");

/* ============ NAV ============ */
const nav=$("#nav"), burger=$(".burger"), drawer=$("#drawer");
burger.addEventListener("click",()=>{const o=drawer.classList.toggle("open");burger.setAttribute("aria-expanded",o);document.body.style.overflow=o?"hidden":"";});
$$("a",drawer).forEach(a=>a.addEventListener("click",()=>{drawer.classList.remove("open");burger.setAttribute("aria-expanded","false");document.body.style.overflow="";}));

/* ============ REVEALS ============ */
const io=new IntersectionObserver(es=>es.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add("in"); io.unobserve(e.target); e.target.dispatchEvent(new CustomEvent("reveal")); }}),{threshold:.18,rootMargin:"0px 0px -8% 0px"});
$$(".rv").forEach(el=>io.observe(el));
if(reduced) $$(".rv").forEach(el=>el.classList.add("in"));

/* ============ HERO PARALLAX (pointer) ============ */
const hv=$("#hv");
if(!reduced && matchMedia("(pointer:fine)").matches){
  addEventListener("pointermove",e=>{
    const x=(e.clientX/innerWidth-.5)*2, y=(e.clientY/innerHeight-.5)*2;
    hv.style.setProperty("--mx",x.toFixed(3)); hv.style.setProperty("--my",y.toFixed(3));
    $(".hero-bg").style.setProperty("--mx",x.toFixed(3)); $(".hero-bg").style.setProperty("--my",y.toFixed(3));
  },{passive:true});
}

/* ============ TYPING (step 01 modal) ============ */
function typeInto(el,text,delay=0){
  if(reduced){el.textContent=text;return Promise.resolve();}
  return new Promise(res=>{ setTimeout(()=>{ let i=0; const t=setInterval(()=>{ el.textContent=text.slice(0,++i); if(i>=text.length){clearInterval(t);res();} },55); },delay); });
}
const modalWrap=$(".modal-ui").closest(".rv");
modalWrap.addEventListener("reveal",async()=>{
  const [a,b]=$$(".typed"); const btn=$("#mBtn");
  await typeInto(a,a.dataset.type,400); await typeInto(b,b.dataset.type,150);
  if(!reduced){ setTimeout(()=>{ btn.classList.add("ok"); btn.textContent=T[lang]["m.saved"]; },500); }
});

/* ============ FORMS (step 06 & 09) ============ */
function animateForm(form){
  const inps=$$(".inp",form); const btn=$(".fbtn",form); const toast=$(".toast",form);
  const isJE=form.id==="formJE";
  if(reduced){ inps.forEach(i=>i.classList.add("filled")); btn.classList.add("done"); btn.textContent=T[lang][isJE?"je.done":"f.done"]; toast.classList.add("show"); return; }
  inps.forEach(i=>i.classList.remove("filled","typing")); btn.className="fbtn"; btn.textContent=T[lang][isJE?"je.save":"f.save"]; toast.classList.remove("show");
  inps.forEach((inp,i)=>{ setTimeout(()=>inp.classList.add("typing"),400+i*520); setTimeout(()=>{inp.classList.remove("typing");inp.classList.add("filled");},400+i*520+420); });
  const end=400+inps.length*520+300;
  setTimeout(()=>{btn.classList.add("saving");btn.textContent=T[lang][isJE?"je.saving":"f.saving"];},end);
  setTimeout(()=>{btn.classList.remove("saving");btn.classList.add("done");btn.textContent=T[lang][isJE?"je.done":"f.done"];toast.classList.add("show");},end+1100);
}
$$(".form-ui").forEach(f=>{ f.closest(".rv").addEventListener("reveal",()=>animateForm(f)); $(".fbtn",f).addEventListener("click",()=>animateForm(f)); });

/* ============ UPLOAD % + pipeline (step 05, 08) ============ */
function countTo(el,to,dur,fmt){ if(reduced){el.textContent=fmt(to);return;} const t0=performance.now(); (function tick(now){ const p=Math.min(1,(now-t0)/dur); const e=1-Math.pow(1-p,3); el.textContent=fmt(to*e); if(p<1) requestAnimationFrame(tick); })(t0); }
$("#upPct").closest(".rv").addEventListener("reveal",()=>{
  countTo($("#upPct"),100,2400,v=>Math.round(v)+"%");
  const nodes=$$("#uplPipe .node"), arrs=$$("#uplPipe .arr");
  nodes.forEach((n,i)=>setTimeout(()=>{ n.classList.add(i===nodes.length-1?"ok":"on"); if(arrs[i]) arrs[i].classList.add("on"); }, reduced?0:300+i*520));
});
$("#jPct").closest(".rv").addEventListener("reveal",()=>countTo($("#jPct"),100,2400,v=>Math.round(v)+"%"));

/* ============ SYNC (step 07) ============ */
$("#syncWrap").addEventListener("reveal",()=>{
  const ring=$("#syncRing"), pct=$("#syncPct"), lbl=$("#syncLbl"), badge=$("#syncBadge");
  badge.style.opacity=reduced?"1":"0"; badge.style.transition="opacity .5s";
  countTo(pct,100,reduced?0:5200,v=>Math.round(v)+"%");
  setTimeout(()=>{ ring.classList.add("done"); lbl.textContent=T[lang]["sync.complete"]; badge.style.opacity="1"; }, reduced?0:5300);
});
