.in .conn-line i{transform:scaleX(1)}

/* ============ DASHBOARD UI (step 02) ============ */
.dash{display:grid;grid-template-columns:200px 1fr;min-height:320px}
.dash .side{background:var(--navy);color:var(--beige);padding:1rem .8rem;display:grid;align-content:start;gap:.2rem;font-size:.85rem}
