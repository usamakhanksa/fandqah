.in .chart .ring{stroke-dashoffset:calc(100 - var(--v))}
.chart .ring-bg{fill:none;stroke:var(--beige-08);stroke-width:8}
.legend{display:flex;gap:1.2rem;font-size:.8rem;color:var(--beige-70);margin-top:.6rem}
.legend span{display:inline-flex;align-items:center;gap:.4rem}
.legend i{width:14px;height:3px;border-radius:2px;background:var(--coral)} .legend i.g{background:var(--green)}
.chart .hbar{height:10px;background:var(--beige-08);border-radius:999px;overflow:hidden;margin-top:.5rem}
.chart .hbar i{display:block;height:100%;width:0;background:var(--coral);border-radius:999px;transition:width 1.6s var(--ease) .2s}
.in .chart .hbar i{width:var(--v)}
.sample{font-size:.78rem;color:var(--beige-70);margin-top:1rem}
@media (max-width:900px){.metrics{grid-template-columns:repeat(2,1fr)}.charts{grid-template-columns:1fr}}

/* ============ VIDEO ============ */
.video-frame{position:relative;border-radius:var(--r-l);padding:clamp(.6rem,1.5vw,1.2rem);background:var(--navy);box-shadow:0 50px 100px -50px rgba(42,39,60,.6)}
.video-frame::before{content:"";position:absolute;inset:0;border-radius:inherit;border:1px solid var(--beige-18);pointer-events:none}
.video-box{position:relative;aspect-ratio:16/9;border-radius:calc(var(--r-l) - .5rem);overflow:hidden;background:var(--navy)}
.video-box iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.poster{position:absolute;inset:0;display:grid;place-items:center;background:
  radial-gradient(ellipse at 70% 30%,rgba(233,90,84,.25),transparent 55%),
  radial-gradient(ellipse at 20% 80%,rgba(251,205,171,.14),transparent 55%),
  repeating-linear-gradient(0deg,var(--beige-04) 0 1px,transparent 1px 48px),var(--navy)}
.poster .pl{width:5.2rem;height:5.2rem;border-radius:50%;background:var(--coral);color:var(--navy);display:grid;place-items:center;box-shadow:0 20px 40px -16px rgba(233,90,84,.8);transition:transform .3s var(--ease)}
.poster .pl svg{width:1.8rem;height:1.8rem;margin-inline-start:.25rem}
.poster:hover .pl{transform:scale(1.06)}
.poster .cap{position:absolute;bottom:1.2rem;inset-inline:1.2rem;display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;color:var(--beige-70);font-size:.85rem}
.poster .cap .badge{background:var(--beige-08);color:var(--beige)}
.vid-links{display:flex;gap:1rem;flex-wrap:wrap;margin-top:1rem;font-size:.9rem}
.vid-links a{color:var(--navy-70)}

/* ============ FAQ ============ */
.faq{max-width:820px;margin-inline:auto;margin-top:2.5rem;border-top:1px solid var(--navy-18)}
.faq-item{border-bottom:1px solid var(--navy-18)}
.faq-item button{width:100%;display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:1.3rem 0;text-align:start;font-weight:600;font-size:1.05rem}
.faq-item button .pm{width:1.8rem;height:1.8rem;border-radius:50%;border:1.5px solid var(--navy-18);display:grid;place-items:center;flex:0 0 auto;transition:all .3s}
.faq-item button .pm::before,.faq-item button .pm::after{content:"";position:absolute;width:.8rem;height:1.5px;background:currentColor;transition:transform .3s}
.faq-item button .pm::after{transform:rotate(90deg)}
.faq-item button[aria-expanded=true] .pm{background:var(--coral);border-color:var(--coral)}
.faq-item button[aria-expanded=true] .pm::after{transform:rotate(0)}
.faq-item .pm{position:relative}
.faq-item .ans{display:grid;grid-template-rows:0fr;transition:grid-template-rows .4s var(--ease)}
.faq-item .ans>div{overflow:hidden}
.faq-item .ans p{padding-bottom:1.3rem;color:var(--navy-70);max-width:62ch}
.faq-item.open .ans{grid-template-rows:1fr}

/* ============ FINAL ============ */
.final{position:relative;overflow:hidden}
.final .wrap{display:grid;grid-template-columns:minmax(0,6fr) minmax(0,6fr);gap:3rem;align-items:center}
.done-card{border:1px solid var(--beige-18);border-radius:var(--r-m);padding:1.6rem;background:var(--beige-04);position:relative;overflow:hidden}
.done-card h4{font-size:.85rem;letter-spacing:.06em;color:var(--beige-70);font-weight:600}
.done-card ul{list-style:none;padding:0;margin:1.2rem 0 0;display:grid;gap:.7rem}
.done-card li{display:flex;align-items:center;gap:.8rem;font-weight:600;font-size:1.05rem;opacity:0;transform:translateX(var(--rx,-10px));transition:all .5s var(--ease)}
[dir=rtl] .done-card li{--rx:10px}
.in .done-card li{opacity:1;transform:none}
.in .done-card li:nth-child(1){transition-delay:.2s}.in .done-card li:nth-child(2){transition-delay:.5s}.in .done-card li:nth-child(3){transition-delay:.8s}.in .done-card li:nth-child(4){transition-delay:1.1s}.in .done-card li:nth-child(5){transition-delay:1.4s}
.done-card li .chk{width:1.6rem;height:1.6rem;font-size:.85rem;transform:scale(0);transition:transform .4s var(--ease)}
.in .done-card li .chk{transform:none}
.in .done-card li:nth-child(1) .chk{transition-delay:.3s}.in .done-card li:nth-child(2) .chk{transition-delay:.6s}.in .done-card li:nth-child(3) .chk{transition-delay:.9s}.in .done-card li:nth-child(4) .chk{transition-delay:1.2s}.in .done-card li:nth-child(5) .chk{transition-delay:1.5s}
.done-card .ready{margin-top:1.6rem;padding-top:1.2rem;border-top:1px solid var(--beige-18);display:flex;justify-content:space-between;align-items:center;gap:1rem}
.done-card .ready b{display:block;font-size:1.2rem}
.done-card .ready span{color:var(--beige-70);font-size:.85rem}
.done-card .node-dot{width:3rem;height:3rem;border-radius:50%;background:var(--coral);display:grid;place-items:center;color:var(--navy);position:relative}
.done-card .node-dot::after{content:"";position:absolute;inset:-6px;border-radius:50%;border:2px solid var(--coral);opacity:0;animation:focusring 2.2s ease-out infinite}
.done-card .stream{position:absolute;inset-inline-start:2rem;bottom:2.4rem;width:calc(100% - 7rem);height:2px;pointer-events:none}
.done-card .stream i{position:absolute;top:-1px;width:14px;height:4px;border-radius:2px;background:var(--peach);opacity:0;animation:stream 2.6s linear infinite}
.done-card .stream i:nth-child(2){animation-delay:.9s;background:var(--green)}.done-card .stream i:nth-child(3){animation-delay:1.7s;background:var(--coral)}
@keyframes stream{0%{inset-inline-start:0;opacity:0}10%{opacity:1}85%{opacity:1}100%{inset-inline-start:100%;opacity:0}}
.final .ctas{display:flex;gap:1rem;flex-wrap:wrap;margin-top:2rem}
@media (max-width:900px){.final .wrap{grid-template-columns:1fr}}

/* ============ FOOTER ============ */
footer{background:var(--navy);color:var(--beige);border-top:1px solid var(--beige-08);padding:3.5rem 0 2rem}
footer .top{display:grid;grid-template-columns:minmax(0,2fr) repeat(2,minmax(0,1fr));gap:2.5rem}
footer p{color:var(--beige-70);max-width:40ch;margin-top:1rem}
footer h4{font-size:.9rem;font-weight:600;color:var(--beige-70);margin-bottom:1rem}
footer ul{list-style:none;padding:0;margin:0;display:grid;gap:.6rem}
footer a{text-decoration:none;opacity:.85} footer a:hover{opacity:1;text-decoration:underline}
footer .bottom{margin-top:3rem;padding-top:1.5rem;border-top:1px solid var(--beige-08);display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;color:var(--beige-70);font-size:.85rem}
@media (max-width:760px){footer .top{grid-template-columns:1fr 1fr}footer .top>div:first-child{grid-column:1/-1}}

/* ============ PROGRESS INDICATOR (signature) ============ */
.prog{position:fixed;z-index:40;inset-inline-end:1.2rem;top:50%;transform:translateY(-50%);display:grid;gap:.6rem;opacity:0;transition:opacity .4s;pointer-events:none}
.prog.show{opacity:1;pointer-events:auto}
.prog a{display:flex;align-items:center;gap:.6rem;text-decoration:none;color:var(--beige);font-size:.75rem;font-weight:600}
.prog.on-light a{color:var(--navy)}
.prog a span{opacity:0;transform:translateX(6px);transition:all .3s;white-space:nowrap;order:-1}
[dir=rtl] .prog a span{transform:translateX(-6px)}
.prog:hover a span,.prog a.active span{opacity:.8;transform:none}
.prog a i{width:10px;height:10px;border-radius:50%;border:2px solid currentColor;opacity:.4;transition:all .3s;flex:0 0 auto}
.prog a.active i{background:var(--coral);border-color:var(--coral);opacity:1;transform:scale(1.25)}
.prog a.done i{background:var(--green);border-color:var(--green);opacity:.9}
.prog .ln{position:absolute;inset-inline-end:4px;top:8px;bottom:8px;width:2px;background:currentColor;opacity:.12;z-index:-1}
@media (max-width:900px){
  .prog{inset-inline:1rem;top:auto;bottom:calc(1rem + env(safe-area-inset-bottom,0px));transform:none;display:flex;justify-content:space-between;background:rgba(42,39,60,.9);backdrop-filter:blur(8px);padding:.6rem .9rem;border-radius:999px;border:1px solid var(--beige-18);gap:.3rem}
  .prog.on-light{background:rgba(42,39,60,.9)} .prog.on-light a{color:var(--beige)}
  .prog a span{display:none}.prog a i{width:9px;height:9px}
  .prog .ln{display:none}
}

/* ============ REDUCED MOTION ============ */
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important;scroll-behavior:auto!important}
  .rv,.sheet tbody tr,.upload li,.done-card li,.story .txt,.scn{opacity:1!important;transform:none!important}
  .hv .wire-on{stroke-dashoffset:0} .map .mid path{stroke-dashoffset:0!important} .map .mid circle{opacity:1!important}
  .mrow .mb{opacity:1!important;transform:none!important} .mrow{border-color:var(--green)!important;background:var(--green-25)!important}
  .chart .ln{stroke-dashoffset:0!important}.chart .bar{transform:none!important}.chart .area{opacity:.12!important}
  .upload .track i{width:100%!important} .done-card li .chk{transform:none!important}
  .story,.peak,.balance{height:auto!important} .story .stage,.peak .stage,.balance .stage{position:relative!important;height:auto!important;padding-block:var(--section)}
  .story .txt{position:relative!important;margin-top:2rem} .scene{display:none} .m-scene{display:block;margin-top:1rem}
  .story .steps-mini{display:none}
  .form-ui .inp .val{opacity:1!important;transform:none!important}
  .scale .beam,.scale .pan{transform:none!important} .scale .ok,.balance .verdict .badge{opacity:1!important}
  .balance .totals .eq{color:var(--green)} .balance .verdict .badge{background:var(--green)!important;color:var(--navy)!important}
  .hero-bg .glow,.hero-bg .glow2,.hv .plane{transform:none!important}
}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
</style>
