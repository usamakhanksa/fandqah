/* ============ FORM UI (step 06, 09) ============ */
.form-ui{background:#fff;color:var(--navy);border-radius:var(--r-m);box-shadow:0 40px 80px -40px rgba(42,39,60,.45),0 0 0 1px var(--navy-08);padding:1.4rem;font-size:.9rem;max-width:520px;margin-inline:auto}
