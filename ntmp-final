const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
function pinProgress(el){ const r=el.getBoundingClientRect(); const total=el.offsetHeight-innerHeight; return clamp(-r.top/total,0,1); }

function update(){
  ticking=false; const y=scrollY; const vh=innerHeight;
  // nav
  nav.classList.toggle("solid",y>40);
  // hero parallax by scroll
  if(y<vh*1.2){ hv.style.setProperty("--sy",y.toFixed(1)); $(".hero-bg").style.setProperty("--sy",y.toFixed(1)); }
  // theme detection for nav & progress (what's under the top bar)
  let theme="dark", phase=0;
  for(const s of sections){ const r=s.getBoundingClientRect(); if(r.top<=80 && r.bottom>80){ theme=s.dataset.theme; phase=+s.dataset.phase; break; } }
  nav.classList.toggle("on-light",theme==="light"); prog.classList.toggle("on-light",theme==="light");
  prog.classList.toggle("show", y>vh*.6 && y<document.body.scrollHeight-vh*1.3);
  progLinks.forEach(a=>{const p=+a.dataset.phase; a.classList.toggle("active",p===phase); a.classList.toggle("done",p<phase);});
  // active nav link
  let cur=null; for(const a of navLinks){ const t=$(a.getAttribute("href")); if(t && t.getBoundingClientRect().top<=120) cur=a; }
  navLinks.forEach(a=>a.classList.toggle("active",a===cur));
  // timeline draw
  { const r=tl.getBoundingClientRect(); const p=clamp((vh*.9-r.top)/(r.height*.9),0,1); tl.style.setProperty("--tp",p.toFixed(3)); tlItems.forEach((it,i)=>it.classList.toggle("on",p>=(i+1)/10-.02)); }
  // story
  if(isDesk() && !reduced){
    const p=pinProgress(story); const idx=clamp(Math.floor(p*5),0,4);
    if(idx!==lastStory){ lastStory=idx; txts.forEach(t=>t.classList.toggle("on",+t.dataset.s===idx)); scns.forEach(s=>s.classList.toggle("on",+s.dataset.s===idx)); }
    // background mix navy->beige across middle then back
    const mix=p<.5? p*2*22 : (1-p)*2*22; stage.style.setProperty("--mix",mix.toFixed(1));
  }
  // peak mapping
  { const p=isDesk()&&!reduced? pinProgress(peak) : clamp((vh*.85-peak.getBoundingClientRect().top)/(vh*.9),0,1);
    let done=0;
    mapRows.forEach(r=>{ const i=+r.dataset.i; const seg=clamp((p-.08-i*.2)/.16,0,1); if(seg>=1) done=Math.max(done,i+1); r.classList.toggle("on",seg>=1); });
    mapPaths.forEach(pt=>{ const i=+pt.dataset.i; const seg=clamp((p-.08-i*.2)/.16,0,1); pt.style.strokeDashoffset=(1-seg).toFixed(3); });
    mapDots.forEach(d=>{ const i=+d.dataset.i; d.style.opacity=(p-.08-i*.2)/.16>=1?1:0; });
    const cnt=mapRows.filter(r=>r.classList.contains("on")).length/2;
    $("#mapCount").textContent=cnt; $("#mapLeft").textContent=4-cnt;
  }
  // balance
  { const p=isDesk()&&!reduced? pinProgress(bal) : clamp((vh*.8-bal.getBoundingClientRect().top)/(vh*.8),0,1);
    const settle=clamp((p-.15)/.55,0,1); const tilt=(1-settle)*Math.sin(p*18)*6*(1-settle);
    bal.style.setProperty("--tilt",tilt.toFixed(2)); bal.classList.toggle("ok",settle>=1); }
}
function onScroll(){ if(!ticking){ ticking=true; requestAnimationFrame(update); } }
addEventListener("scroll",onScroll,{passive:true}); addEventListener("resize",onScroll,{passive:true}); update();
if(reduced){ mapRows.forEach(r=>r.classList.add("on")); bal.classList.add("ok"); $("#mapCount").textContent=4; $("#mapLeft").textContent=0; }
})();
</script>
