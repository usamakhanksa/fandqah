.totals{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:1.5rem;margin-top:2rem;text-align:center;font-variant-numeric:tabular-nums}
.totals b{display:block;font-size:clamp(1.6rem,1.2rem + 2vw,2.6rem);font-weight:600;line-height:1}
.totals span{font-size:.85rem;color:var(--beige-70);display:block;margin-bottom:.4rem}
