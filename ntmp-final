@keyframes travel{0%{offset-distance:0%;opacity:0}8%{opacity:1}92%{opacity:1}100%{offset-distance:100%;opacity:0}}
.ui{background:var(--beige);color:var(--navy);border-radius:var(--r-m);box-shadow:0 30px 60px -30px rgba(0,0,0,.55),0 2px 0 rgba(255,255,255,.4) inset;font-size:.85rem;overflow:hidden}
