/* ============ SYNC (step 07) ============ */
.sync-wrap{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:1.5rem}
.sync-ring{position:relative;width:min(260px,60vw);height:min(260px,60vw);margin-inline:auto}
.sync-ring svg{width:100%;height:100%;overflow:visible}
.sync-ring .track{fill:none;stroke:var(--beige-18);stroke-width:2}
